{
  "name": "tree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file=.env --import tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "db:migrate": "node --env-file=.env --import tsx server/scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mcp": "node --env-file=.env --import tsx server/mcp.ts",
    "mcp:http": "node --env-file=.env --import tsx server/mcp-http.ts",
    "mcp:http:smoke": "node --env-file=.env --import tsx server/scripts/mcp-http-smoke.ts",
    "mcp:smoke": "node --env-file=.env --import tsx server/scripts/mcp-smoke.ts",
    "mcp:token": "node --import tsx server/scripts/ensure-mcp-token.ts",
    "preview": "vite preview",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts server/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "fastify": "^5.12.0",
    "i18next": "^26.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
